# Environment Configuration
# ========================
# Replace placeholder values with real credentials before production deployment.

# Kafka (in-network clients use the internal listener on port 29092;
# localhost:9092 remains available for host tools via PLAINTEXT_HOST)
KAFKA_BROKERS=kafka:29092
KAFKA_TOPIC_LOGS=logs
KAFKA_TOPIC_DLQ=logs-dlq
KAFKA_GROUP_WORKERS=processing-workers
KAFKA_GROUP_ARCHIVE=archive-writers
KAFKA_GROUP_DETECTION=detection-service

# ClickHouse (self-hosted hot analytics in docker-compose).
# Workers insert as logs_append; the query coordinator selects as logs_read.
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=logs
CLICKHOUSE_ADMIN_PASSWORD=clickhouse
CLICKHOUSE_APPEND_USER=logs_append
CLICKHOUSE_APPEND_PASSWORD=append
CLICKHOUSE_READ_USER=logs_read
CLICKHOUSE_READ_PASSWORD=read

# Cloudflare R2 (managed archive) over its S3-compatible API. The S3_* names
# refer to the API dialect, not AWS. Create the bucket in Cloudflare before
# starting the stack.
S3_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=log-archive
S3_ACCESS_KEY=REPLACE_WITH_R2_ACCESS_KEY_ID
S3_SECRET_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
S3_ENSURE_BUCKET=false

# Gateway
GATEWAY_PORT=8080
GATEWAY_INGEST_QUOTA_PER_SEC=15000

# Processing workers: batches seal every WORKER_BATCH_SIZE events or
# WORKER_FLUSH_INTERVAL_MS (whichever first); up to
# WORKER_APPEND_CONCURRENCY ClickHouse inserts run in flight per worker.
WORKER_BATCH_SIZE=5000
WORKER_FLUSH_INTERVAL_MS=250
WORKER_APPEND_CONCURRENCY=16

# Query Coordinator
QUERY_COORDINATOR_PORT=8081
QUERY_HOT_RETENTION_DAYS=7
QUERY_MAX_SCAN_BYTES=1073741824

# Detection
DETECTION_WINDOW_MINUTES=5
DETECTION_ERROR_RATE_THRESHOLD=0.05
DETECTION_MIN_EVENTS=100

# Alert Service
ALERT_SERVICE_PORT=8082
ALERT_WEBHOOK_URL=PLACEHOLDER_ALERT_WEBHOOK_URL

# Prometheus
PROMETHEUS_PORT=9090

# UI
UI_PORT=3000

